{
  "name": "@repo/server-elysia",
  "version": "0.1.0",
  "description": "Elysia REST API and Socket.IO gateway",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "start": "node dist/index.js",
    "start:node": "node dist/index.js",
    "build": "node scripts/build.mjs && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.19.0",
    "@repo/database": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exact-mirror": "0.2.7",
    "elysia": "^1.4.30",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
