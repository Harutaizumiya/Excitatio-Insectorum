# Elysia Standalone Server Environment Configuration
NODE_ENV=development
PORT=3000

# Database URL: SQLite dev database path (relative to packages/database/prisma/sqlite)
DATABASE_URL=file:../../packages/database/prisma/sqlite/dev.db

# JWT & Authentication Configuration
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

INVITATION_EXPIRES_IN=24h
DEVICE_ACCESS_EXPIRES_IN=30m
DEVICE_BINDING_ENCRYPTION_SECRET=replace-with-a-third-32-character-random-secret

# CORS allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Swagger UI toggle
SWAGGER_ENABLED=true
