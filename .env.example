NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excitatio_insectorum?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

INVITATION_EXPIRES_IN=24h
DEVICE_ACCESS_EXPIRES_IN=30m
DEVICE_BINDING_ENCRYPTION_SECRET=replace-with-a-third-32-character-random-secret

CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=debug
SWAGGER_ENABLED=true

NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
