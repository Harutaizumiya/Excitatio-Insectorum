# Copy this file to apps/server-elysia/.env for local backend development.
NODE_ENV=development
PORT=3000
# SQLite is the default local database. The database file is created by Prisma migrations.
DATABASE_URL=file:./dev.db
# PostgreSQL remains supported through the *:postgresql database scripts:
# DATABASE_URL=postgresql://postgres:123456@localhost:5432/excitatio_insectorum?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

INVITATION_EXPIRES_IN=24h
DEVICE_ACCESS_EXPIRES_IN=30m
DEVICE_BINDING_ENCRYPTION_SECRET=replace-with-a-third-32-character-random-secret

CORS_ORIGIN=http://localhost:3001
# Public origin embedded in shareable invitation URLs. Defaults to the first CORS origin.
PUBLIC_WEB_ORIGIN=http://localhost:3001
LOG_LEVEL=debug
SWAGGER_ENABLED=true
# Frontend API Origin (Vite SPA 默认留空走同源反代；若需跨域独立后端则填完整地址)
VITE_API_ORIGIN=
