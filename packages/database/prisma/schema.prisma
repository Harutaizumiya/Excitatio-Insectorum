generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TeacherRole {
  HEAD_TEACHER
  SUBJECT_TEACHER
}

enum RelationStatus {
  ACTIVE
  REVOKED
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum StudentGender {
  MALE
  FEMALE
  UNKNOWN
}

enum SeatCellType {
  SEAT
  AISLE
  PODIUM
  EMPTY
}

enum ScoreRecordType {
  NORMAL
  REVERT
}

enum ScorePeriodStatus {
  OPEN
  SETTLED
}

enum ScoreEventType {
  LATE
  SCHOOL_UNIFORM
  EVENING_SELF_STUDY_CALLOUT
  NO_VIOLATION_REWARD
  NOISIEST_CLASS_TOP3
  HOMEWORK_MISSING
  HOMEWORK_PRAISE
  EXAM_GRADE_TOP10
  SUBJECT_TOP3
  BREAKTHROUGH
  PROGRESS
  DUTY_HYGIENE
  DORM_HYGIENE
  COMMITTEE_TASK_COMPLETED
  COMMITTEE_REWARD
  BLACKBOARD
  INDIVIDUAL_ACTIVITY
  GROUP_ACTIVITY
  SPORTS_FINAL_TOP8
  ACTIVITY_NEGATIVE
  MANUAL
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SessionClientType {
  ADMIN_WEB
  TEACHER_MOBILE
}

enum UsageClientType {
  DISPLAY
  ADMIN_WEB
  TEACHER_MOBILE
  OTHER
}

enum UsageEventResult {
  SUCCESS
  FAILURE
}

enum FeedbackType {
  BUG
  DIFFICULTY
  DATA_ISSUE
  FEATURE_REQUEST
  OTHER
}

enum FeedbackStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String              @id @default(cuid())
  name           String              @db.VarChar(100)
  account        String              @unique @db.VarChar(100)
  passwordHash   String              @db.VarChar(255)
  status         UserStatus          @default(ACTIVE)
  classLinks     ClassTeacher[]
  sessions       Session[]
  createdLayouts SeatLayoutVersion[] @relation("LayoutCreator")
  createdRules   ScoreRule[]         @relation("RuleCreator")
  scoreRecords   ScoreRecord[]       @relation("ScoreOperator")
  scoreEvents    ScoreEvent[]        @relation("ScoreEventOperator")
  usageEvents    UsageEvent[]
  submittedFeedbacks Feedback[]      @relation("FeedbackSubmitter")
  processedFeedbacks Feedback[]      @relation("FeedbackProcessor")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
}

model Classroom {
  id                     String              @id @default(cuid())
  name                   String              @db.VarChar(120)
  grade                  String?             @db.VarChar(50)
  schoolYear             String?             @db.VarChar(20)
  gridRows               Int                 @default(7)
  gridCols               Int                 @default(11)
  currentLayoutVersionId String?             @unique
  activeScheduleTemplateId String?           @unique
  status                 String              @default("ACTIVE") @db.VarChar(30)
  currentLayout          SeatLayoutVersion?  @relation("CurrentClassroomLayout", fields: [currentLayoutVersionId], references: [id], onDelete: SetNull)
  activeScheduleTemplate  ScheduleTemplate?  @relation("ClassroomActiveScheduleTemplate", fields: [activeScheduleTemplateId], references: [id], onDelete: SetNull)
  teachers               ClassTeacher[]
  students               Student[]
  dormitories             Dormitory[]
  layouts                SeatLayoutVersion[] @relation("ClassroomLayoutVersions")
  scoreRules             ScoreRule[]
  scorePeriods           ScorePeriod[]
  scoreEvents            ScoreEvent[]
  scoreRecords           ScoreRecord[]
  committeeAssignments   ClassCommitteeAssignment[]
  displayDevices         DisplayDevice[]
  scheduleTemplates      ScheduleTemplate[]  @relation("ClassroomScheduleTemplates")
  scheduleEntries        ScheduleEntry[]
  usageEvents            UsageEvent[]
  feedbacks              Feedback[]
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status])
}

model ClassTeacher {
  id          String              @id @default(cuid())
  classId     String
  teacherId   String
  role        TeacherRole
  subject     String?             @db.VarChar(100)
  status      RelationStatus      @default(ACTIVE)
  classroom   Classroom           @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher     User                @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  invitations TeacherInvitation[]
  scheduleEntries ScheduleEntry[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@index([classId, status])
  @@index([teacherId, status])
  @@index([classId, role, status])
}

model ScheduleTemplate {
  id              String                    @id @default(cuid())
  classId         String
  name            String                    @db.VarChar(100)
  classroom       Classroom                 @relation("ClassroomScheduleTemplates", fields: [classId], references: [id], onDelete: Restrict)
  activeClassroom Classroom?                @relation("ClassroomActiveScheduleTemplate")
  periods         ScheduleTemplatePeriod[]
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([classId, name])
  @@index([classId, updatedAt])
}

model ScheduleTemplatePeriod {
  id         String           @id @default(cuid())
  templateId String
  periodNo   Int
  startTime  String           @db.VarChar(5)
  endTime    String           @db.VarChar(5)
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodNo])
  @@index([templateId, periodNo])
}

model ScheduleEntry {
  id            String        @id @default(cuid())
  classId       String
  weekday       Int
  periodNo      Int
  courseName    String        @db.VarChar(100)
  classTeacherId String?
  classroom     Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher  ClassTeacher? @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([classId, weekday, periodNo])
  @@index([classId, weekday, periodNo])
  @@index([classTeacherId])
}

model TeacherInvitation {
  id             String           @id @default(cuid())
  classTeacherId String
  tokenHash      String           @unique @db.VarChar(255)
  expiresAt      DateTime         @db.Timestamptz(3)
  usedAt         DateTime?        @db.Timestamptz(3)
  status         InvitationStatus @default(PENDING)
  classTeacher   ClassTeacher     @relation(fields: [classTeacherId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([classTeacherId])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model Student {
  id        String        @id @default(cuid())
  classId   String
  name      String        @db.VarChar(100)
  studentNo String?       @db.VarChar(50)
  gender    StudentGender @default(UNKNOWN)
  status    StudentStatus @default(ACTIVE)
  deletedAt DateTime?
  dormitoryId String?
  classroom Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  dormitory Dormitory?    @relation(fields: [classId, dormitoryId], references: [classId, id], onDelete: Restrict)
  seats     Seat[]
  scores    ScoreRecord[]
  scoreEventParticipants ScoreEventParticipant[]
  committeeAssignments  ClassCommitteeAssignment[]
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([classId, studentNo])
  @@index([classId, status])
  @@index([classId, deletedAt, status])
  @@index([dormitoryId])
}

model Dormitory {
  id        String    @id @default(cuid())
  classId   String
  name      String    @db.VarChar(100)
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Restrict)
  students  Student[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([classId, name])
  @@unique([classId, id])
  @@index([classId])
}

model SeatLayoutVersion {
  id                  String              @id @default(cuid())
  classId             String
  version             Int
  rotationWeekKey     String?             @db.VarChar(10)
  sourceVersionId     String?
  createdBy           String
  classroom           Classroom           @relation("ClassroomLayoutVersions", fields: [classId], references: [id], onDelete: Restrict)
  currentForClassroom Classroom?          @relation("CurrentClassroomLayout")
  sourceVersion       SeatLayoutVersion?  @relation("LayoutRestorationSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  restoredVersions    SeatLayoutVersion[] @relation("LayoutRestorationSource")
  creator             User                @relation("LayoutCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  seats               Seat[]
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([classId, version])
  @@unique([classId, rotationWeekKey])
  @@index([classId, createdAt])
  @@index([sourceVersionId])
  @@index([createdBy])
}

model Seat {
  id              String            @id @default(cuid())
  layoutVersionId String
  rowIndex        Int
  colIndex        Int
  studentId       String?
  cellType        SeatCellType      @default(SEAT)
  layout          SeatLayoutVersion @relation(fields: [layoutVersionId], references: [id], onDelete: Restrict)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([layoutVersionId, rowIndex, colIndex])
  @@unique([layoutVersionId, studentId])
  @@index([layoutVersionId])
  @@index([studentId])
}

model ScoreRule {
  id           String        @id @default(cuid())
  classId      String
  name         String        @db.VarChar(100)
  group        String        @default("课堂表现") @db.VarChar(100)
  delta        Int
  description  String?       @db.Text
  systemPolicyKey String?     @db.VarChar(100)
  enabled      Boolean       @default(true)
  createdBy    String
  classroom    Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  creator      User          @relation("RuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  scoreRecords ScoreRecord[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([classId, enabled])
  @@index([classId, systemPolicyKey])
  @@index([createdBy])
}

model ScorePeriod {
  id          String            @id @default(cuid())
  classId     String
  startAt     DateTime          @db.Timestamptz(3)
  endAt       DateTime          @db.Timestamptz(3)
  initialScore Int                @default(100)
  status      ScorePeriodStatus @default(OPEN)
  settledAt   DateTime?         @db.Timestamptz(3)
  classroom   Classroom         @relation(fields: [classId], references: [id], onDelete: Restrict)
  events      ScoreEvent[]
  records     ScoreRecord[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([classId, startAt, endAt])
  @@index([classId, startAt, endAt])
  @@index([classId, status])
}

model ScoreEvent {
  id            String          @id @default(cuid())
  classId       String
  periodId      String
  type          ScoreEventType
  operatorId    String
  occurredAt    DateTime        @db.Timestamptz(3)
  reason        String?         @db.Text
  parameters    String?         @db.Text
  businessKey   String?         @unique @db.VarChar(255)
  sourceDormitoryId String?      @db.VarChar(191)
  sourceDormitoryName String?    @db.VarChar(100)
  classroom     Classroom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  period        ScorePeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  operator      User            @relation("ScoreEventOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  participants  ScoreEventParticipant[]
  scoreRecords  ScoreRecord[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([classId, occurredAt])
  @@index([periodId, type])
  @@index([operatorId, occurredAt])
  @@index([classId, sourceDormitoryId, occurredAt])
}

model ScoreEventParticipant {
  eventId   String
  studentId String
  event     ScoreEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([eventId, studentId])
  @@index([studentId])
}

model ClassCommitteeAssignment {
  id          String         @id @default(cuid())
  classId     String
  studentId   String
  role        String         @db.VarChar(50)
  subject     String?        @db.VarChar(100)
  termStartAt DateTime       @db.Timestamptz(3)
  termEndAt   DateTime?      @db.Timestamptz(3)
  trialEndsAt DateTime?      @db.Timestamptz(3)
  status      RelationStatus @default(ACTIVE)
  classroom   Classroom      @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([classId, studentId, role, termStartAt])
  @@index([classId, status, termStartAt, termEndAt])
  @@index([studentId, status])
}

model ScoreRecord {
  id               String          @id @default(cuid())
  classId          String
  studentId        String
  operatorId       String
  periodId         String?
  eventId          String?
  subject          String?         @db.VarChar(100)
  ruleId           String?
  delta            Int
  reason           String?         @db.Text
  recordType       ScoreRecordType @default(NORMAL)
  occurredAt       DateTime?       @db.Timestamptz(3)
  violation        Boolean         @default(false)
  revertedRecordId String?         @unique
  classroom        Classroom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  operator         User            @relation("ScoreOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  period           ScorePeriod?    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  event            ScoreEvent?     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  rule             ScoreRule?      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  revertedRecord   ScoreRecord?    @relation("ScoreRecordReversion", fields: [revertedRecordId], references: [id], onDelete: Restrict)
  reversion        ScoreRecord?    @relation("ScoreRecordReversion")
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  @@index([classId, createdAt])
  @@index([periodId, studentId, createdAt])
  @@index([eventId])
  @@index([studentId, createdAt])
  @@index([operatorId, createdAt])
  @@index([classId, studentId, createdAt])
  @@index([ruleId])
  @@index([revertedRecordId])
}

model DisplayDevice {
  id          String             @id @default(cuid())
  classId     String
  name        String             @db.VarChar(120)
  status      DeviceStatus       @default(ACTIVE)
  lastSeenAt  DateTime?          @db.Timestamptz(3)
  revokedAt   DateTime?          @db.Timestamptz(3)
  classroom   Classroom          @relation(fields: [classId], references: [id], onDelete: Restrict)
  credentials DeviceCredential[]
  usageEvents UsageEvent[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  @@index([classId, status])
}

model UsageEvent {
  id             String           @id @default(cuid())
  eventName      String           @db.VarChar(100)
  clientType     UsageClientType
  result         UsageEventResult @default(SUCCESS)
  classId        String
  userId         String?
  deviceId       String?
  userRole       TeacherRole?
  module         String?          @db.VarChar(80)
  page           String?          @db.VarChar(200)
  appVersion     String?          @db.VarChar(50)
  browser        String?          @db.VarChar(255)
  traceId        String           @db.VarChar(100)
  errorCode      String?          @db.VarChar(100)
  properties     Json?
  occurredAt     DateTime         @db.Timestamptz(3)
  classroom      Classroom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  device         DisplayDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([classId, occurredAt])
  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([traceId])
}

model Feedback {
  id             String         @id @default(cuid())
  code           String         @unique @db.VarChar(32)
  type           FeedbackType
  status         FeedbackStatus @default(PENDING)
  description    String
  screenshotUrl  String?        @db.VarChar(1000)
  clientType     UsageClientType
  classId        String
  submittedById  String
  module         String?        @db.VarChar(80)
  page           String?        @db.VarChar(200)
  appVersion     String?        @db.VarChar(50)
  browser        String?        @db.VarChar(255)
  traceId        String         @db.VarChar(100)
  processingNote String?
  processedById  String?
  processedAt    DateTime?      @db.Timestamptz(3)
  classroom      Classroom      @relation(fields: [classId], references: [id], onDelete: Restrict)
  submittedBy    User           @relation("FeedbackSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  processedBy    User?          @relation("FeedbackProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([classId, createdAt])
  @@index([classId, status, createdAt])
  @@index([submittedById, createdAt])
  @@index([traceId])
}

model DeviceCredential {
  id         String        @id @default(cuid())
  deviceId   String
  secretHash String        @unique @db.VarChar(255)
  device     DisplayDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime?     @db.Timestamptz(3)
  revokedAt  DateTime?     @db.Timestamptz(3)

  @@index([deviceId])
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
}

model Session {
  id               String            @id @default(cuid())
  userId           String
  refreshTokenHash String            @unique @db.VarChar(255)
  clientType       SessionClientType
  expiresAt        DateTime          @db.Timestamptz(3)
  revokedAt        DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime?         @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
