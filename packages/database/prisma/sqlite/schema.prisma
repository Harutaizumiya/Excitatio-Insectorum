generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TeacherRole {
  HEAD_TEACHER
  SUBJECT_TEACHER
}

enum RelationStatus {
  ACTIVE
  REVOKED
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum StudentGender {
  MALE
  FEMALE
  UNKNOWN
}

enum SeatCellType {
  SEAT
  AISLE
  PODIUM
  EMPTY
}

enum ScoreRecordType {
  NORMAL
  REVERT
}

enum ScorePeriodStatus {
  OPEN
  SETTLED
}

enum ScoreEventType {
  LATE
  SCHOOL_UNIFORM
  EVENING_SELF_STUDY_CALLOUT
  NO_VIOLATION_REWARD
  NOISIEST_CLASS_TOP3
  HOMEWORK_MISSING
  HOMEWORK_PRAISE
  EXAM_GRADE_TOP10
  SUBJECT_TOP3
  BREAKTHROUGH
  PROGRESS
  DUTY_HYGIENE
  DORM_HYGIENE
  COMMITTEE_TASK_COMPLETED
  COMMITTEE_REWARD
  BLACKBOARD
  INDIVIDUAL_ACTIVITY
  GROUP_ACTIVITY
  SPORTS_FINAL_TOP8
  ACTIVITY_NEGATIVE
  MANUAL
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SessionClientType {
  ADMIN_WEB
  TEACHER_MOBILE
}

model User {
  id             String              @id @default(cuid())
  name           String
  account        String              @unique
  passwordHash   String
  status         UserStatus          @default(ACTIVE)
  classLinks     ClassTeacher[]
  sessions       Session[]
  createdLayouts SeatLayoutVersion[] @relation("LayoutCreator")
  createdRules   ScoreRule[]         @relation("RuleCreator")
  scoreRecords   ScoreRecord[]       @relation("ScoreOperator")
  scoreEvents    ScoreEvent[]        @relation("ScoreEventOperator")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Classroom {
  id                     String              @id @default(cuid())
  name                   String
  grade                  String?
  schoolYear             String?
  gridRows               Int                 @default(7)
  gridCols               Int                 @default(11)
  currentLayoutVersionId String?             @unique
  activeScheduleTemplateId String?           @unique
  status                 String              @default("ACTIVE")
  currentLayout          SeatLayoutVersion?  @relation("CurrentClassroomLayout", fields: [currentLayoutVersionId], references: [id], onDelete: SetNull)
  activeScheduleTemplate  ScheduleTemplate?  @relation("ClassroomActiveScheduleTemplate", fields: [activeScheduleTemplateId], references: [id], onDelete: SetNull)
  teachers               ClassTeacher[]
  students               Student[]
  layouts                SeatLayoutVersion[] @relation("ClassroomLayoutVersions")
  scoreRules             ScoreRule[]
  scorePeriods           ScorePeriod[]
  scoreEvents            ScoreEvent[]
  scoreRecords           ScoreRecord[]
  committeeAssignments   ClassCommitteeAssignment[]
  displayDevices         DisplayDevice[]
  scheduleTemplates      ScheduleTemplate[]  @relation("ClassroomScheduleTemplates")
  scheduleEntries        ScheduleEntry[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status])
}

model ClassTeacher {
  id          String              @id @default(cuid())
  classId     String
  teacherId   String
  role        TeacherRole
  subject     String?
  status      RelationStatus      @default(ACTIVE)
  classroom   Classroom           @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher     User                @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  invitations TeacherInvitation[]
  scheduleEntries ScheduleEntry[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([classId, status])
  @@index([teacherId, status])
  @@index([classId, role, status])
}

model ScheduleTemplate {
  id              String                    @id @default(cuid())
  classId         String
  name            String
  classroom       Classroom                 @relation("ClassroomScheduleTemplates", fields: [classId], references: [id], onDelete: Restrict)
  activeClassroom Classroom?                @relation("ClassroomActiveScheduleTemplate")
  periods         ScheduleTemplatePeriod[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([classId, name])
  @@index([classId, updatedAt])
}

model ScheduleTemplatePeriod {
  id         String           @id @default(cuid())
  templateId String
  periodNo   Int
  startTime  String
  endTime    String
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodNo])
  @@index([templateId, periodNo])
}

model ScheduleEntry {
  id            String        @id @default(cuid())
  classId       String
  weekday       Int
  periodNo      Int
  courseName    String
  classTeacherId String?
  classroom     Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher  ClassTeacher? @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([classId, weekday, periodNo])
  @@index([classId, weekday, periodNo])
  @@index([classTeacherId])
}

model TeacherInvitation {
  id             String           @id @default(cuid())
  classTeacherId String
  tokenHash      String           @unique
  expiresAt      DateTime
  usedAt         DateTime?
  status         InvitationStatus @default(PENDING)
  classTeacher   ClassTeacher     @relation(fields: [classTeacherId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@index([classTeacherId])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model Student {
  id        String        @id @default(cuid())
  classId   String
  name      String
  studentNo String?
  gender    StudentGender @default(UNKNOWN)
  status    StudentStatus @default(ACTIVE)
  deletedAt DateTime?
  classroom Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  seats     Seat[]
  scores    ScoreRecord[]
  scoreEventParticipants ScoreEventParticipant[]
  committeeAssignments  ClassCommitteeAssignment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([classId, studentNo])
  @@index([classId, status])
  @@index([classId, deletedAt, status])
}

model SeatLayoutVersion {
  id                  String              @id @default(cuid())
  classId             String
  version             Int
  sourceVersionId     String?
  createdBy           String
  classroom           Classroom           @relation("ClassroomLayoutVersions", fields: [classId], references: [id], onDelete: Restrict)
  currentForClassroom Classroom?          @relation("CurrentClassroomLayout")
  sourceVersion       SeatLayoutVersion?  @relation("LayoutRestorationSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  restoredVersions    SeatLayoutVersion[] @relation("LayoutRestorationSource")
  creator             User                @relation("LayoutCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  seats               Seat[]
  createdAt           DateTime            @default(now())

  @@unique([classId, version])
  @@index([classId, createdAt])
  @@index([sourceVersionId])
  @@index([createdBy])
}

model Seat {
  id              String            @id @default(cuid())
  layoutVersionId String
  rowIndex        Int
  colIndex        Int
  studentId       String?
  cellType        SeatCellType      @default(SEAT)
  layout          SeatLayoutVersion @relation(fields: [layoutVersionId], references: [id], onDelete: Restrict)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([layoutVersionId, rowIndex, colIndex])
  @@unique([layoutVersionId, studentId])
  @@index([layoutVersionId])
  @@index([studentId])
}

model ScoreRule {
  id           String        @id @default(cuid())
  classId      String
  name         String
  group        String        @default("课堂表现")
  delta        Int
  description  String?
  systemPolicyKey String?
  enabled      Boolean       @default(true)
  createdBy    String
  classroom    Classroom     @relation(fields: [classId], references: [id], onDelete: Restrict)
  creator      User          @relation("RuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  scoreRecords ScoreRecord[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([classId, enabled])
  @@index([classId, systemPolicyKey])
  @@index([createdBy])
}

model ScorePeriod {
  id          String            @id @default(cuid())
  classId     String
  startAt     DateTime
  endAt       DateTime
  initialScore Int                @default(100)
  status      ScorePeriodStatus @default(OPEN)
  settledAt   DateTime?
  classroom   Classroom         @relation(fields: [classId], references: [id], onDelete: Restrict)
  events      ScoreEvent[]
  records     ScoreRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([classId, startAt, endAt])
  @@index([classId, startAt, endAt])
  @@index([classId, status])
}

model ScoreEvent {
  id            String          @id @default(cuid())
  classId       String
  periodId      String
  type          ScoreEventType
  operatorId    String
  occurredAt    DateTime
  reason        String?
  parameters    String?
  businessKey   String?         @unique
  classroom     Classroom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  period        ScorePeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  operator      User            @relation("ScoreEventOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  participants  ScoreEventParticipant[]
  scoreRecords  ScoreRecord[]
  createdAt     DateTime        @default(now())

  @@index([classId, occurredAt])
  @@index([periodId, type])
  @@index([operatorId, occurredAt])
}

model ScoreEventParticipant {
  eventId   String
  studentId String
  event     ScoreEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([eventId, studentId])
  @@index([studentId])
}

model ClassCommitteeAssignment {
  id          String         @id @default(cuid())
  classId     String
  studentId   String
  role        String
  subject     String?
  termStartAt DateTime
  termEndAt   DateTime?
  trialEndsAt DateTime?
  status      RelationStatus @default(ACTIVE)
  classroom   Classroom      @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([classId, studentId, role, termStartAt])
  @@index([classId, status, termStartAt, termEndAt])
  @@index([studentId, status])
}

model ScoreRecord {
  id               String          @id @default(cuid())
  classId          String
  studentId        String
  operatorId       String
  periodId         String?
  eventId          String?
  subject          String?
  ruleId           String?
  delta            Int
  reason           String?
  recordType       ScoreRecordType @default(NORMAL)
  occurredAt       DateTime?
  violation        Boolean         @default(false)
  revertedRecordId String?         @unique
  classroom        Classroom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  operator         User            @relation("ScoreOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  period           ScorePeriod?    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  event            ScoreEvent?     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  rule             ScoreRule?      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  revertedRecord   ScoreRecord?    @relation("ScoreRecordReversion", fields: [revertedRecordId], references: [id], onDelete: Restrict)
  reversion        ScoreRecord?    @relation("ScoreRecordReversion")
  createdAt        DateTime        @default(now())

  @@index([classId, createdAt])
  @@index([periodId, studentId, createdAt])
  @@index([eventId])
  @@index([studentId, createdAt])
  @@index([operatorId, createdAt])
  @@index([classId, studentId, createdAt])
  @@index([ruleId])
  @@index([revertedRecordId])
}

model DisplayDevice {
  id          String             @id @default(cuid())
  classId     String
  name        String
  status      DeviceStatus       @default(ACTIVE)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  classroom   Classroom          @relation(fields: [classId], references: [id], onDelete: Restrict)
  credentials DeviceCredential[]
  createdAt   DateTime           @default(now())

  @@index([classId, status])
}

model DeviceCredential {
  id         String        @id @default(cuid())
  deviceId   String
  secretHash String        @unique
  device     DisplayDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([deviceId])
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
}

model Session {
  id               String            @id @default(cuid())
  userId           String
  refreshTokenHash String            @unique
  clientType       SessionClientType
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  lastUsedAt       DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
